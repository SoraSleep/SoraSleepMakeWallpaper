{
  "name": "motion-pair-studio",
  "private": true,
  "version": "0.1.0",
  "desktopVersion": "1.0.1",
  "type": "module",
  "scripts": {
    "build:desktop": "node scripts/build-desktop.mjs",
    "runtime:check": "node scripts/runtime-check.mjs",
    "studio:start": "node scripts/studio-launch.mjs",
    "build:portable": "npm run build && node scripts/package-portable.mjs",
    "test:portable": "node scripts/portable-smoke.mjs",
    "test:landscape-upgrade": "node scripts/landscape-upgrade-acceptance.mjs",
    "test:manager-integration": "node --test integrations/manager-desktop/*.test.mjs",
    "test:portable-runtime": "node --test scripts/runtime-config.test.mjs scripts/project-mirror.test.mjs",
    "test:t2i-contract": "node --experimental-strip-types --test text-to-image-contract.test.mjs",
    "test:t2i-b2-live": "node scripts/text-to-image-b2-live.mjs",
    "test:t2i-gallery": "node scripts/text-to-image-b3-ui.mjs && node scripts/text-to-image-b3-scale-ui.mjs",
    "test:t2i-export": "node scripts/text-to-image-b4-ui.mjs",
    "test:t2i-final": "node scripts/text-to-image-b5-live.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:portal-export": "node scripts/portal-runtime-smoke.mjs",
    "test:parallax-qa": "node scripts/parallax-qa.mjs",
    "test:a5-pilot": "node scripts/a5-pilot.mjs",
    "test:bridge": "node --test wallpaper-bridge.test.mjs wallpaper-jobs.test.mjs wallpaper-art-plan.test.mjs artwork-plan-store.test.mjs sales-bundle.test.mjs image-dream-adapter.test.mjs product-store.test.mjs render-jobs.test.mjs landscape-contract.test.mjs landscape-source.test.mjs",
    "test:job-api": "node scripts/job-api-acceptance.mjs",
    "test:landscape": "node scripts/c2-landscape-acceptance.mjs",
    "test:landscape-ui": "node scripts/c2-landscape-ui.mjs",
    "test:wardrobe": "node --experimental-strip-types --test wardrobe.test.mjs",
    "test:wardrobe-ui": "node scripts/c4-completion-ui.mjs",
    "test:wardrobe-output": "node scripts/c4-export-quality.mjs",
    "test:reveal-studio": "node scripts/reveal-studio-ui.mjs",
    "test:plr-plan": "node --experimental-strip-types --test plr-plan.test.mjs",
    "test:plr-ui": "node scripts/plr-plan-ui.mjs",
    "test:plr-prompts": "node --experimental-strip-types --test plr-prompt-file.test.mjs",
    "test:plr-prompt-ui": "node scripts/plr-prompt-ui.mjs",
    "test:plr-manager-ui": "node scripts/plr-manager-ui.mjs",
    "dev:plr-manager": "node scripts/plr-manager-service.mjs",
    "test:plr-preflight-ui": "node scripts/plr-preflight-ui.mjs",
    "test:plr-dispatcher-live": "node scripts/plr-dispatcher-live-ui.mjs",
    "test:plr-segmentation": "node scripts/plr-segmentation-pilot.mjs",
    "test:plr-segmentation-ui": "node scripts/plr-segmentation-ui.mjs",
    "test:plr-quality": "node scripts/plr-quality-pilot.mjs",
    "test:plr-package": "node scripts/plr-package-pilot.mjs",
    "test:plr-workflow-live": "node scripts/plr-workflow-live.mjs",
    "test:plr-ten-live": "node scripts/plr-ten-prompt-live.mjs",
    "test:plr-fault-ui": "node scripts/plr-fault-recovery-ui.mjs",
    "test:plr-trim-live": "node scripts/plr-trim-live.mjs",
    "test:plr-trim-ui": "node scripts/plr-trim-ui.mjs",
    "test:plr-workspace-ui": "node scripts/plr-workspace-ui.mjs",
    "test:plr-listing": "node scripts/plr-listing-pilot.mjs",
    "test:plr-fifteen-live": "node scripts/plr-fifteen-live.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "mp4-muxer": "^5.2.2",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.5",
    "typescript": "latest"
  }
}
